<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Ahora en JOX3" (celular, 4×2). La tarjeta del medio se encoge si el launcher da poco alto;
     la fila de canales siempre cabe completa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false"
            android:text="J3" android:textColor="#FF22C3EE" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:includeFontPadding="false" android:text="@string/widget_home_title"
            android:textColor="#FFE8EDF5" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_profile" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:includeFontPadding="false" android:maxLines="1" android:maxWidth="120dp" android:ellipsize="end"
            android:textColor="#FF8A97AA" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_resume" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:minHeight="40dp"
        android:background="@drawable/widget_card" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="5dp" android:paddingBottom="5dp">
        <ImageView android:id="@+id/w_poster" android:layout_width="38dp" android:layout_height="match_parent"
            android:maxHeight="54dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:text="@string/widget_continue" android:textColor="#FF8A97AA" android:textSize="10sp" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:layout_marginTop="1dp"
                android:maxLines="1" android:ellipsize="end" android:textColor="#FFE8EDF5" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:includeFontPadding="false" android:layout_marginTop="1dp"
                android:maxLines="1" android:ellipsize="end" android:textColor="#FF8A97AA" android:textSize="11sp" />
            <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp"
                android:max="1000" android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
        <ImageView android:id="@+id/w_play" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginStart="6dp" android:background="@drawable/widget_play" android:padding="8dp"
            android:src="@drawable/ic_play" android:contentDescription="@string/widget_continue" />
    </LinearLayout>

    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:background="@drawable/widget_card"
        android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:text="@string/widget_empty" android:textColor="#FF8A97AA" android:textSize="11sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_channels" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_ch0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/w_logo0" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" android:contentDescription="@null" />
            <TextView android:id="@+id/w_now0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:textColor="#FFB8C3D3" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_ch1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/w_logo1" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" android:contentDescription="@null" />
            <TextView android:id="@+id/w_now1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:textColor="#FFB8C3D3" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_ch2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/w_logo2" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" android:contentDescription="@null" />
            <TextView android:id="@+id/w_now2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:textColor="#FFB8C3D3" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_ch3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/w_logo3" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" android:contentDescription="@null" />
            <TextView android:id="@+id/w_now3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:textColor="#FFB8C3D3" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
