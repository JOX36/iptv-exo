<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══════════ LIVE: PlayerView fullscreen ═══════════ -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fill" />

    <!-- LIVE — barra superior (scrim degradado) -->
    <LinearLayout
        android:id="@+id/live_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/live_btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Volver" />

        <TextView
            android:id="@+id/live_txt_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/live_txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_live"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/live_txt_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#00D4FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/live_btn_fav"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_star"
            android:scaleType="centerInside"
            android:padding="9dp"
            app:tint="#FFC107"
            android:contentDescription="Favorito" />

    </LinearLayout>

    <!-- LIVE — barra inferior: EPG + botones circulares (scrim degradado) -->
    <LinearLayout
        android:id="@+id/live_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="26dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- EPG -->
        <LinearLayout
            android:id="@+id/live_epg_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/live_epg_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AHORA"
                    android:textColor="#00D4FF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/live_epg_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/live_epg_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7AB8CC"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/live_epg_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#997AB8CC"
                android:textSize="10sp"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <ProgressBar
                android:id="@+id/live_epg_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:progressTint="#00D4FF"
                android:progressBackgroundTint="#26FFFFFF"
                android:max="100" />

        </LinearLayout>

        <!-- Fila de botones circulares -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <ImageButton
                android:id="@+id/live_btn_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_prev"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Canal anterior" />

            <ImageButton
                android:id="@+id/live_btn_pip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_pip"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="PiP" />

            <ImageButton
                android:id="@+id/live_btn_audio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle_accent"
                android:src="@drawable/ic_audio"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="10dp"
                app:tint="#00D4FF"
                android:contentDescription="Audio" />

            <ImageButton
                android:id="@+id/live_btn_ext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_ext"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Reproductor externo" />

            <ImageButton
                android:id="@+id/live_btn_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_stop"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:layout_marginEnd="10dp"
                app:tint="#FF5252"
                android:contentDescription="Detener" />

            <ImageButton
                android:id="@+id/live_btn_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_next"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Canal siguiente" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════ VOD: layout vertical (video + info) ═══════════ -->
    <LinearLayout
        android:id="@+id/vod_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0A0E14"
        android:visibility="gone">

        <!-- Video (el Java manipula el weight de este FrameLayout: 4 normal / 10 fullscreen) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4">

            <androidx.media3.ui.PlayerView
                android:id="@+id/vod_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit" />

            <!-- Barra superior VOD (overlay sobre el video) -->
            <LinearLayout
                android:id="@+id/vod_top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/bg_scrim_top"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="18dp">

                <ImageButton
                    android:id="@+id/vod_btn_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_circle"
                    android:src="@drawable/ic_back"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="Volver" />

                <TextView
                    android:id="@+id/vod_txt_title_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="8"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/vod_btn_fav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_circle"
                    android:src="@drawable/ic_star"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    app:tint="#FFC107"
                    android:contentDescription="Favorito" />

            </LinearLayout>

        </FrameLayout>

        <!-- Info scrollable -->
        <ScrollView
            android:id="@+id/vod_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/vod_txt_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Meta chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/vod_txt_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:textColor="#7AB8CC"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/vod_txt_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:textColor="#7AB8CC"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/vod_txt_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:textColor="#FFC107"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/vod_txt_resolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:textColor="#00D4FF"
                        android:textSize="10sp"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/vod_txt_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#7AB8CC"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.35" />

                <!-- Acciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="18dp">

                    <ImageButton
                        android:id="@+id/vod_btn_fullscreen"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle_accent"
                        android:src="@drawable/ic_fullscreen"
                        android:scaleType="centerInside"
                        android:padding="11dp"
                        app:tint="#00D4FF"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Pantalla completa" />

                    <ImageButton
                        android:id="@+id/vod_btn_pip"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@drawable/ic_pip"
                        android:scaleType="centerInside"
                        android:padding="11dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="PiP" />

                    <ImageButton
                        android:id="@+id/vod_btn_audio"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@drawable/ic_audio"
                        android:scaleType="centerInside"
                        android:padding="11dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone"
                        android:contentDescription="Audio" />

                    <ImageButton
                        android:id="@+id/vod_btn_subs"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@drawable/ic_subs"
                        android:scaleType="centerInside"
                        android:padding="11dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone"
                        android:contentDescription="Subtítulos" />

                    <ImageButton
                        android:id="@+id/vod_btn_ext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@drawable/ic_ext"
                        android:scaleType="centerInside"
                        android:padding="11dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Externo" />

                    <ImageButton
                        android:id="@+id/vod_btn_copy"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@drawable/ic_copy"
                        android:scaleType="centerInside"
                        android:padding="11dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Copiar URL" />

                    <ImageButton
                        android:id="@+id/vod_btn_stop"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_circle"
                        android:src="@drawable/ic_stop"
                        android:scaleType="centerInside"
                        android:padding="12dp"
                        app:tint="#FF5252"
                        android:contentDescription="Detener" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ═══════════ VOD FULLSCREEN — barra superior ═══════════ -->
    <LinearLayout
        android:id="@+id/vod_fs_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/vod_fs_btn_exit"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Salir de pantalla completa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vod_fs_txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowRadius="8"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/vod_fs_txt_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00D4FF"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/vod_fs_btn_subs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_subs"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:contentDescription="Subtítulos" />

        <ImageButton
            android:id="@+id/vod_fs_btn_url"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_copy"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Copiar URL" />

        <ImageButton
            android:id="@+id/vod_fs_btn_ext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_ext"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Externo" />

        <ImageButton
            android:id="@+id/vod_fs_btn_pip"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_circle"
            android:src="@drawable/ic_pip"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="PiP" />

    </LinearLayout>

    <!-- ═══════════ VOD FULLSCREEN — bloque inferior: centro + seekbar + acciones ═══════════ -->
    <LinearLayout
        android:id="@+id/vod_fs_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="30dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Controles centrales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <ImageButton
                android:id="@+id/vod_fs_btn_ep_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_prev"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginEnd="18dp"
                android:visibility="gone"
                android:contentDescription="Episodio anterior" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="26dp">
                <ImageButton
                    android:id="@+id/vod_fs_btn_rew"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_btn_circle"
                    android:src="@drawable/ic_rew10"
                    android:scaleType="centerInside"
                    android:padding="11dp"
                    android:contentDescription="Retroceder 10s" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10s"
                    android:textColor="#B3FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/vod_fs_btn_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_circle_accent"
                android:src="@drawable/ic_pause"
                android:scaleType="centerInside"
                android:padding="14dp"
                app:tint="#00D4FF"
                android:contentDescription="Play / Pausa" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="26dp">
                <ImageButton
                    android:id="@+id/vod_fs_btn_ffw"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_btn_circle"
                    android:src="@drawable/ic_ffw10"
                    android:scaleType="centerInside"
                    android:padding="11dp"
                    android:contentDescription="Adelantar 10s" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10s"
                    android:textColor="#B3FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/vod_fs_btn_ep_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_next"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_marginStart="18dp"
                android:visibility="gone"
                android:contentDescription="Episodio siguiente" />

        </LinearLayout>

        <!-- Seekbar + tiempos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/vod_fs_time_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E0F4FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="0:00" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/vod_fs_seekbar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:played_color="#00D4FF"
                app:buffered_color="#5900D4FF"
                app:unplayed_color="#26FFFFFF"
                app:scrubber_color="#FFFFFF"
                app:bar_height="3dp" />

            <TextView
                android:id="@+id/vod_fs_time_tot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#997AB8CC"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="0:00" />

        </LinearLayout>

        <!-- Fila de acciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/vod_fs_btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="52dp"
                android:background="@drawable/bg_chip_speed"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Velocidad" />

            <ImageButton
                android:id="@+id/vod_fs_btn_resize"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_resize"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Tamaño de video" />

            <ImageButton
                android:id="@+id/vod_fs_btn_dl"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_download"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Descargar" />

            <ImageButton
                android:id="@+id/vod_fs_btn_stop"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_circle"
                android:src="@drawable/ic_stop"
                android:scaleType="centerInside"
                android:padding="10dp"
                app:tint="#FF5252"
                android:contentDescription="Detener" />

        </LinearLayout>

    </LinearLayout>

    <!-- DIAGNÓSTICO TEMPORAL — texto fijo, no depende de permisos de notificación -->
    <TextView
        android:id="@+id/debug_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:background="#DD000000"
        android:textColor="#00FF88"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:text=""
        android:visibility="gone" />

    <!-- ═══════════ LOADING ═══════════ -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#CC000000"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:indeterminateTint="#00d4ff" />

        <TextView
            android:id="@+id/txt_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectando..."
            android:textColor="#7ab8cc"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- ═══════════ GESTOS — Volumen (izquierda) ═══════════ -->
    <LinearLayout
        android:id="@+id/gesture_overlay"
        android:layout_width="36dp"
        android:layout_height="200dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:background="#CC0a0e14"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/gesture_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="🔊"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="12dp"
            android:layout_height="120dp"
            android:background="#33FFFFFF">
            <View
                android:id="@+id/gesture_progress"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="#00D4FF" />
        </FrameLayout>

        <TextView
            android:id="@+id/gesture_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="6dp"
            android:text="50%" />

    </LinearLayout>

    <!-- GESTOS — Seek (centro) -->
    <LinearLayout
        android:id="@+id/gesture_seek_overlay"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC0a0e14"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/gesture_seek_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="⏩"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/gesture_seek_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:text="0:00:00" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#33FFFFFF">
            <View
                android:id="@+id/gesture_seek_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#00D4FF" />
        </FrameLayout>

    </LinearLayout>

    <!-- GESTOS — Brillo (derecha) -->
    <LinearLayout
        android:id="@+id/gesture_overlay_right"
        android:layout_width="36dp"
        android:layout_height="200dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="#CC0a0e14"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/gesture_icon_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="☀️"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="12dp"
            android:layout_height="120dp"
            android:background="#33FFFFFF">
            <View
                android:id="@+id/gesture_progress_right"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="#FFD700" />
        </FrameLayout>

        <TextView
            android:id="@+id/gesture_value_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="6dp"
            android:text="50%" />

    </LinearLayout>

    <!-- ═══════════ SIGUIENTE EPISODIO ═══════════ -->
    <LinearLayout
        android:id="@+id/next_ep_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="#E60D1219"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/next_ep_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxWidth="220dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Siguiente episodio" />

        <TextView
            android:id="@+id/next_ep_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00D4FF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:text="En 5 segundos..." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/next_ep_btn_now"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶ Ahora"
                android:textSize="12sp"
                android:backgroundTint="#00D4FF"
                android:textColor="#000000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/next_ep_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="✕ Cancelar"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
