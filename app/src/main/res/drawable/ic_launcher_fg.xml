<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono adaptable: TV con antena, botón de reproducir y punto EN VIVO.
     Todo dentro de la zona segura (66 dp centrales) para que ningún launcher lo recorte. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Antena -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#6FE7FF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M45,27L54,35L63,27" />
    <!-- Pantalla con degradado cian → azul -->
    <path android:pathData="M33,35L75,35A8,8 0,0 1,83 43L83,69A8,8 0,0 1,75 77L33,77A8,8 0,0 1,25 69L25,43A8,8 0,0 1,33 35Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="25" android:startY="35"
                android:endX="83" android:endY="77"
                android:startColor="#00D4FF"
                android:endColor="#2563FF" />
        </aapt:attr>
    </path>
    <!-- Brillo suave arriba -->
    <path
        android:fillColor="#26FFFFFF"
        android:pathData="M33,35L75,35A8,8 0,0 1,83 43L83,49Q54,43 25,52L25,43A8,8 0,0 1,33 35Z" />
    <!-- Reproducir -->
    <path
        android:fillColor="#07121F"
        android:pathData="M48,46.5Q48,44 50.2,45.3L63.5,53.6Q65.5,55 63.5,56.4L50.2,64.7Q48,66 48,63.5Z" />
    <!-- Punto EN VIVO -->
    <path
        android:fillColor="#FF5A4E"
        android:strokeColor="#07121F"
        android:strokeWidth="2"
        android:pathData="M76,42m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
    <!-- Base -->
    <path
        android:fillColor="#5B8CFF"
        android:pathData="M45,80L63,80A2,2 0,0 1,65 82L65,82A2,2 0,0 1,63 84L45,84A2,2 0,0 1,43 82L43,82A2,2 0,0 1,45 80Z" />
</vector>
